# Copy to .dev.vars for local development. Never commit .dev.vars.
DEV_MODE=1
# 32 or more random bytes, base64. Used to hash link tokens and encrypt the
# organization's AT Protocol app password.
APP_SECRET=change-me-to-a-long-random-string
# Optional: email for sign-in codes and the emails the tool sends. Set
# RESEND_API_KEY to use Resend, or the AWS keys to use Amazon SES. Resend wins
# if both are set. Without either, DEV_MODE shows the sign-in code and no
# email goes out.
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
EMAIL_FROM=
# Optional: model for reading text, Word and PDF imports, and for tagging
# people, tasks and needs as they come in.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
