{
  "name": "voluntold",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@material/material-color-utilities": "^0.4.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=22"
  }
}
